		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^22.0.0",
		"jsdom": "^29.1.1",
		"mdsvex": "^0.12.7",
		"svelte": "^5.55.0",
		"svelte-check": "^4.4.8",
		"typescript": "^6.0.3",
		"vite": "^8.0.14",
		"vitest": "^4.1.7"
	}
