		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.2.0",
		"jsdom": "^30.0.1",
		"mdsvex": "^0.12.8",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	}
